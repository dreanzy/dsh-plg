{
  "name": "@dreanzy/dsh-lsp-lens",
  "version": "0.1.0",
  "description": "把语言服务器的诊断在改完代码后回灌给模型，不依赖模型主动调用 lsp 工具。",
  "keywords": ["dsh", "dsh-plugin", "lsp", "diagnostics", "feedback"],
  "license": "MIT",
  "author": "dreanzy <dreanzy@outlook.com>",
  "homepage": "https://github.com/dreanzy/dsh-plg/tree/main/packages/dsh-lsp-lens#readme",
  "repository": { "type": "git", "url": "git+https://github.com/dreanzy/dsh-plg.git", "directory": "packages/dsh-lsp-lens" },
  "bugs": { "url": "https://github.com/dreanzy/dsh-plg/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-isolation=none test/",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json && node --test --test-isolation=none test/"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.0.0" }
}

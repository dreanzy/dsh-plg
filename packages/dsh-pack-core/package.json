{
  "name": "@dreanzy/dsh-pack-core",
  "version": "0.1.0",
  "description": "四个 pack 插件共用的服务端骨架：会话目录、装配记账、求值链与落盘规则。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pack",
    "core",
    "workspace"
  ],
  "license": "MIT",
  "author": "dreanzy <dreanzy@outlook.com>",
  "homepage": "https://github.com/dreanzy/dsh-plg/tree/main/packages/dsh-pack-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreanzy/dsh-plg.git",
    "directory": "packages/dsh-pack-core"
  },
  "bugs": {
    "url": "https://github.com/dreanzy/dsh-plg/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-isolation=none test/",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json && node --test --test-isolation=none test/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2 || ^0.2.1-0 || ^0.2.2-rc.0"
  }
}

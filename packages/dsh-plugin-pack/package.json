{
  "name": "@dreanzy/dsh-plugin-pack",
  "version": "0.2.0",
  "description": "按工作区停用 DSH 插件：把插件的工具与提示词段从模型可见范围里摘掉，按 pack 分组管理。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "tool-hiding",
    "prompt-filter",
    "pack",
    "workspace"
  ],
  "license": "MIT",
  "author": "dreanzy <dreanzy@outlook.com>",
  "homepage": "https://github.com/dreanzy/dsh-plg/tree/main/packages/dsh-plugin-pack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreanzy/dsh-plg.git",
    "directory": "packages/dsh-plugin-pack"
  },
  "bugs": {
    "url": "https://github.com/dreanzy/dsh-plg/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-isolation=none test/",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json && node --test --test-isolation=none test/"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.2 || ^0.2.1-0 || ^0.2.2-rc.0",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2 || ^0.2.1-0 || ^0.2.2-rc.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
